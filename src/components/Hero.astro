---
const socialLinks = [
  { label: 'Email', href: 'mailto:kthurimella@gmail.com', icon: 'email' },
  { label: 'Google Scholar', href: 'https://scholar.google.com/citations?user=3PVZTukAAAAJ', icon: 'scholar' },
  { label: 'GitHub', href: 'https://github.com/kthurimella', icon: 'github' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/kumarthurimella', icon: 'linkedin' },
];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__photo">
      <img src="/images/WhiteCoat.jpg" alt="Kumar Thurimella" width="180" height="180" loading="eager" />
    </div>
    <div class="hero__text">
      <h1 class="hero__name">Kumar Thurimella</h1>
      <p class="hero__tagline">MD/PhD Candidate &middot; Applied Mathematician &middot; Former Software Engineer</p>
      <p class="hero__affiliation">University of Colorado School of Medicine &middot; University of Cambridge</p>
      <div class="hero__social">
        {socialLinks.map(({ label, href, icon }) => (
          <a href={href} class="hero__social-link" target="_blank" rel="noopener noreferrer" aria-label={label}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              {icon === 'email' && <Fragment><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></Fragment>}
              {icon === 'scholar' && <Fragment><path d="M12 14l-4-4h8l-4 4z" fill="currentColor" stroke="none" /><path d="M22 9l-10 7L2 9l10-7 10 7z" /><path d="M6 11.5V17a6 6 0 0 0 12 0v-5.5" /></Fragment>}
              {icon === 'github' && <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />}
              {icon === 'linkedin' && <Fragment><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" /><rect x="2" y="9" width="4" height="12" /><circle cx="4" cy="4" r="2" /></Fragment>}
            </svg>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-4xl) 0 var(--space-2xl);
  }

  .hero__inner {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
  }

  .hero__photo img {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--color-accent);
    box-shadow: var(--shadow-lg);
  }

  .hero__name {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-xs);
  }

  .hero__tagline {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xs);
  }

  .hero__affiliation {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-md);
  }

  .hero__social {
    display: flex;
    gap: var(--space-md);
  }

  .hero__social-link {
    color: var(--color-text-secondary);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .hero__social-link:hover {
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .hero__social-link svg {
    width: 22px;
    height: 22px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--space-2xl) 0 var(--space-xl);
    }

    .hero__inner {
      flex-direction: column;
      text-align: center;
    }

    .hero__social {
      justify-content: center;
    }

    .hero__name {
      font-size: 1.75rem;
    }
  }
</style>
